# Copy to .env.local for Next.js (must live in stablepad/, same folder as package.json)

# Dev: http://localhost:3040 (`npm run dev`).

# --- Chain selection ---
# Active EVM chain: stable | local (anvil)
NEXT_PUBLIC_EVM_CHAIN=local

# Deployed StableLaunchpad address on the active chain. Production (stable)
# reads the address from lib/evm/chains.ts DEPLOYMENTS — this override is for
# local anvil runs (deploy with `npm run evm:local`, FEE_RECIPIENT required).
NEXT_PUBLIC_LAUNCHPAD_ADDRESS=

# RPC overrides (defaults exist for mainnet/local; set when they differ)
# NEXT_PUBLIC_STABLE_RPC_URL=https://rpc.stable.xyz
# NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545

# Public site origin, used for /l/<id> short links pinned into token metadata
# NEXT_PUBLIC_SITE_URL=https://thestable.fun

# WalletConnect Cloud project id — without it only injected wallets (MetaMask etc.) work
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- IPFS (token images + metadata) ---
# Server-only JWT from https://pinata.cloud — never commit the real value.
# PINATA_JWT=eyJ...
# PINATA_GATEWAY=https://mygateway.mypinata.cloud
# NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud

# --- Indexer ---
# Postgres in production (Railway plugin sets DATABASE_URL).
# Unset locally = embedded PGlite under .data/curve-pglite (zero setup).
# DATABASE_URL=postgres://user:pass@host:5432/db
# EVM_INDEXER_START_BLOCK=0     # first run: backfill from this block (default: current head)
# EVM_INDEXER_DISABLED=1        # turn the in-process indexer off

# --- Vanity mining ---
# Token address suffix (hex only); default 5b1e
# VANITY_SUFFIX=5b1e
